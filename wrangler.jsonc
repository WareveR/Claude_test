{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-calendar",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // Production database, created in the EU jurisdiction (#53).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-calendar",
      "database_id": "92b00576-8549-4ba5-b9ef-3ae6e9c7ec51",
      "migrations_dir": "migrations",
    },
  ],
  // Backups live in their own bucket, so an image cleanup can never touch them.
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "family-calendar-images" },
    { "binding": "BACKUPS", "bucket_name": "family-calendar-backups" },
  ],
  // Workers AI writes the Briefing and reads Voice Entry sentences.
  "ai": { "binding": "AI" },
  // Cloudflare Email Service; the sender address is set with the own domain (#53).
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "EMAIL_FROM": "calendar@example.com",
    // Open-Meteo, free and keyless; the e2e tests point these at a local fake.
    "OPEN_METEO_FORECAST_URL": "https://api.open-meteo.com",
    "OPEN_METEO_GEOCODING_URL": "https://geocoding-api.open-meteo.com",
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
}
